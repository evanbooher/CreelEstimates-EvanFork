.Rhistory
.Rapp.history

# Session Data files
.RData

# User-specific files
.Ruserdata

# Example code in package build process
*-Ex.R

# Output files from R CMD build
/*.tar.gz

# Output files from R CMD check
/*.Rcheck/

# RStudio files
.Rproj.user/

# produced vignettes
vignettes/*.html
vignettes/*.pdf

# OAuth2 token, see https://github.com/hadley/httr/releases/tag/v0.3
.httr-oauth

# knitr and R markdown default cache directories
*_cache/
/cache/

# Temporary files created by R markdown
*.utf8.md
*.knit.md

# R Environment Variables
.Renviron

# local directory of output files
/fishery_analyses
/project_outputs
/project_scripts

# RDS file with parameters supplied to analysis-specific render.analysis.R script 
/input_files/params_list.rds

# Database configuration file
config.yml

# Dev container configuration
.devcontainer/
.devcontainer

# BSS effort-bias analysis. Two things are deliberately NOT tracked -- full
# stanfit objects, which are large, and the DWG fetch cache, which is a local
# copy of public data.wa.gov records that any clone can re-fetch.
#
# EVERYTHING ELSE UNDER outputs/ IS TRACKED ON PURPOSE. The CSVs, the gt HTML
# tables, the figures and the raw b draws are what let a collaborator run
# 06_variability_analysis.R and 07_catch_sensitivity.R in seconds instead of
# re-running every Stan fit -- and what lets them check our numbers against
# their own rather than take them on faith. They are the deliverable, not
# intermediate files.
/analysis/bss_bias/outputs/fits/
/analysis/bss_bias/outputs/cache/

# Stray exports written to the repo root by ad-hoc data pulls -- not inputs to
# anything in the pipeline, and they clutter the commit pane on every run.
/dwg_export.xlsx
/interview_out.csv
